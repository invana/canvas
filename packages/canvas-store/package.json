{
  "name": "@invana/canvas-store",
  "version": "0.0.12",
  "description": "State machinery of the Invana canvas \u2014 the immer-backed ReactiveStore engine + adapters (zustand now, Yjs later), history, picking (rbush), telemetry, and the CanvasStore factory. The vocabulary and contracts live one floor below in @invana/canvas-core.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ tests/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "@invana/canvas-core": "workspace:*",
    "immer": "^11.1.4",
    "rbush": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/rbush": "^4.0.0",
    "tsup": "^8.3.5",
    "typescript": "5.9.2",
    "vitest": "^3.2.6"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "keywords": [
    "state",
    "reactive",
    "store",
    "telemetry",
    "crdt",
    "canvas"
  ],
  "license": "Apache-2.0",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

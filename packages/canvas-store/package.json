{
  "name": "@invana/canvas-store",
  "version": "0.0.9",
  "description": "Renderer-free kernel for the Invana canvas — state (ReactiveStore port + view/data stores), event bus, telemetry, history. The engine (@invana/canvas) is a pixi renderer over this.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ tests/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "immer": "^11.1.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "5.9.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "keywords": [
    "state",
    "reactive",
    "store",
    "telemetry",
    "crdt",
    "canvas"
  ],
  "license": "Apache-2.0",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

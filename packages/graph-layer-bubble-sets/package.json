{
  "name": "@invana/graph-layer-bubble-sets",
  "version": "0.0.1",
  "description": "BubbleSets annotation layer for @invana/graph — smooth contours around named node groups, with edge enclosure and non-member routing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "bubblesets-js": "^3.0.1"
  },
  "peerDependencies": {
    "@invana/canvas": "workspace:*",
    "@invana/graph": "workspace:*",
    "pixi.js": "^8.18.1"
  },
  "devDependencies": {
    "@invana/canvas": "workspace:*",
    "@invana/graph": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "pixi.js": "^8.18.1",
    "tsup": "^8.3.5",
    "typescript": "5.9.2"
  },
  "keywords": [
    "canvas",
    "graph",
    "layer",
    "annotation",
    "bubblesets",
    "bubble-sets",
    "set-cover",
    "contour"
  ],
  "license": "Apache-2.0",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

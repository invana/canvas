{
  "name": "@invana/graph-datasets",
  "version": "0.0.11",
  "description": "Example graph datasets for @invana/graph (Les Misérables, scientists org chart, random tree, etc.).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./usecase-demos": {
      "types": "./dist/usecase-demos/index.d.ts",
      "import": "./dist/usecase-demos/index.js",
      "default": "./dist/usecase-demos/index.js"
    },
    "./epic-saga": {
      "types": "./dist/epic-saga/index.d.ts",
      "import": "./dist/epic-saga/index.js",
      "default": "./dist/epic-saga/index.js"
    },
    "./topic-cartography": {
      "types": "./dist/topic-cartography/index.d.ts",
      "import": "./dist/topic-cartography/index.js",
      "default": "./dist/topic-cartography/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@invana/canvas": "workspace:*",
    "@invana/graph": "workspace:*"
  },
  "devDependencies": {
    "@invana/canvas": "workspace:*",
    "@invana/graph": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "5.9.2",
    "vitest": "^3.2.6"
  },
  "keywords": [
    "canvas",
    "graph",
    "datasets",
    "examples",
    "visualization"
  ],
  "license": "Apache-2.0",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

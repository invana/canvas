{
  "name": "@invana/plugins-shapes",
  "version": "0.0.1",
  "description": "Shapes plugin for @invana/canvas — ShapesPlugin rendering engine, shape/connector classes, routers, and animations.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.ts",
  "typedocOptions": {
    "entryPoints": ["src/index.ts"]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "rbush": "^4.0.1"
  },
  "peerDependencies": {
    "@invana/canvas": "workspace:*",
    "pixi.js": "^8.18.1"
  },
  "devDependencies": {
    "@invana/canvas": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/rbush": "^4.0.0",
    "pixi.js": "^8.18.1",
    "tsup": "^8.3.5",
    "typescript": "5.9.2"
  },
  "keywords": [
    "canvas",
    "shapes",
    "connectors",
    "visualization"
  ],
  "license": "Apache-2.0"
}

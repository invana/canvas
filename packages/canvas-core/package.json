{
  "name": "@invana/canvas-core",
  "version": "0.0.12",
  "description": "The dependency-free floor of the Invana canvas: the spec vocabulary (shapes/connectors/decorations as plain data) + pure geometry, the renderer contract, the Layer/Behaviour/Layout abstracts, CanvasContext, Camera semantics, the event bus, theme signal, data primitives and the ReactiveStore port contract. canvas-store (state machinery) and canvas (orchestrator) both build on it.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./specs": {
      "types": "./dist/specs/index.d.ts",
      "import": "./dist/specs/index.js",
      "default": "./dist/specs/index.js"
    }
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ tests/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "5.9.2",
    "vitest": "^3.2.6"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "keywords": [
    "canvas",
    "renderer-contract",
    "layer",
    "behaviour",
    "layout",
    "headless"
  ],
  "license": "Apache-2.0",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

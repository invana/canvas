{
  "name": "@invana/canvas-core",
  "version": "0.0.11",
  "description": "Contracts and abstracts of the Invana canvas engine — the renderer contract (IRenderer/ISurface/…), the Layer/Behaviour/Layout base classes, CanvasContext, Camera semantics, connector geometry, badge placement, SVG serialisers and the headless reference implementation. A rendering backend or extension package depends on this, not on the whole engine.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ tests/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@invana/canvas-store": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "5.9.2",
    "vitest": "^3.2.6"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "keywords": [
    "canvas",
    "renderer-contract",
    "layer",
    "behaviour",
    "layout",
    "headless"
  ],
  "license": "Apache-2.0",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

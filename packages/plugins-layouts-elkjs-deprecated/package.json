{
  "name": "@invana/plugin-layouts-elkjs-deprecated",
  "version": "0.0.1",
  "description": "[DEPRECATED] ELK.js layout plugin for @invana/canvas — kept for reference during architecture migration.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "typedocOptions": {
    "entryPoints": ["src/index.ts"]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "elkjs": "^0.9.3"
  },
  "peerDependencies": {
    "@invana/canvas-deprecated": "workspace:*",
    "@invana/plugins-graph-data-deprecated": "workspace:*"
  },
  "devDependencies": {
    "@invana/canvas-deprecated": "workspace:*",
    "@invana/plugins-graph-data-deprecated": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "5.9.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "canvas",
    "layout",
    "elk",
    "elkjs",
    "hierarchical",
    "layered",
    "graph-layout",
    "graph-visualization",
    "deprecated"
  ],
  "license": "Apache-2.0"
}

{
  "name": "@invana/renderer-pixijs",
  "version": "0.0.14",
  "description": "PixiJS drawing backend for @invana/canvas — implements IRenderer + IPrimitivesRenderer, owns the Application, viewport, primitives, textures and fonts.",
  "homepage": "https://github.com/invana/canvas#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ tests/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pixi.js": "^8.20.1"
  },
  "peerDependencies": {
    "@invana/canvas-core": "workspace:*",
    "@invana/canvas-store": "workspace:*"
  },
  "devDependencies": {
    "@invana/canvas-core": "workspace:*",
    "@invana/canvas-store": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "pixi-viewport": "^6.0.3",
    "tsup": "^8.3.5",
    "typescript": "5.9.2",
    "vitest": "^3.2.6"
  },
  "keywords": [
    "canvas",
    "renderer",
    "pixijs",
    "webgpu",
    "webgl",
    "backend"
  ],
  "bugs": {
    "url": "https://github.com/invana/canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invana/canvas.git",
    "directory": "packages/renderer-pixijs"
  },
  "license": "Apache-2.0",
  "author": "Ravi Raja Merugu",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

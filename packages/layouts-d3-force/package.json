{
  "name": "@invana/layouts-d3-force",
  "version": "0.0.1",
  "description": "D3 force-directed layout plugin for @invana/canvas-core",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "d3-force": "^3.0.0"
  },
  "peerDependencies": {
    "@invana/canvas-core": "workspace:*"
  },
  "devDependencies": {
    "@invana/canvas-core": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/d3-force": "^3.0.10",
    "tsup": "^8.3.5",
    "typescript": "5.9.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "canvas",
    "layout",
    "d3",
    "force-directed",
    "graph-visualization"
  ],
  "license": "Apache-2.0"
}

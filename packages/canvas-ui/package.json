{
  "name": "@invana/canvas-ui",
  "version": "0.0.12",
  "description": "Schema-driven, engine-agnostic React UI components (style editors, panels, controls) for Invana graph tools — built on the @invana/forms design-kit form-generator.",
  "homepage": "https://github.com/invana/canvas#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@invana/canvas": "workspace:*",
    "@invana/canvas-react": "workspace:*",
    "@invana/forms": "*",
    "@invana/graph": "workspace:*",
    "@invana/graph-layout-d3-force": "workspace:*",
    "@invana/styling": "*",
    "@invana/themes": "*",
    "@invana/ui": "*",
    "lucide-react": ">=0.400.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7"
  },
  "devDependencies": {
    "@invana/canvas": "workspace:*",
    "@invana/canvas-react": "workspace:*",
    "@invana/forms": "^0.0.23",
    "@invana/graph": "workspace:*",
    "@invana/graph-layout-d3-force": "workspace:*",
    "@invana/styling": "^0.0.23",
    "@invana/themes": "^0.0.23",
    "@invana/ui": "^0.0.23",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "lucide-react": "^0.562.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.69.0",
    "tsup": "^8.3.5",
    "typescript": "5.9.2"
  },
  "keywords": [
    "canvas",
    "react",
    "ui",
    "components",
    "graph",
    "editor",
    "design-kit"
  ],
  "bugs": {
    "url": "https://github.com/invana/canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invana/canvas.git",
    "directory": "packages/canvas-ui"
  },
  "license": "Apache-2.0",
  "author": "Ravi Raja Merugu",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@invana/canvas-ui",
  "version": "0.0.1",
  "description": "Schema-driven, engine-agnostic React UI components (style editors, panels, controls) for Invana graph tools — built on the @invana/forms design-kit form-generator.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@invana/graph": "workspace:*",
    "@invana/ui": "*",
    "@invana/themes": "*",
    "@invana/styling": "*",
    "@invana/forms": "*",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-hook-form": "^7"
  },
  "devDependencies": {
    "@invana/graph": "workspace:*",
    "@invana/ui": "github:invana/design-kit#releases/ui",
    "@invana/themes": "github:invana/design-kit#releases/themes",
    "@invana/styling": "github:invana/design-kit#releases/styling",
    "@invana/forms": "github:invana/design-kit#releases/forms",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.69.0",
    "tsup": "^8.3.5",
    "typescript": "5.9.2"
  },
  "keywords": [
    "canvas",
    "react",
    "ui",
    "components",
    "graph",
    "editor",
    "design-kit"
  ],
  "license": "Apache-2.0"
}

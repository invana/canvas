{
  "name": "@invana/canvas-ui",
  "version": "0.0.8",
  "description": "Schema-driven, engine-agnostic React UI components (style editors, panels, controls) for Invana graph tools — built on the @invana/forms design-kit form-generator.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@invana/graph": "workspace:*",
    "@invana/ui": "*",
    "@invana/themes": "*",
    "@invana/styling": "*",
    "@invana/forms": "*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7"
  },
  "devDependencies": {
    "@invana/graph": "workspace:*",
    "@invana/ui": "^0.0.12",
    "@invana/themes": "^0.0.12",
    "@invana/styling": "^0.0.12",
    "@invana/forms": "^0.0.12",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.69.0",
    "tsup": "^8.3.5",
    "typescript": "5.9.2"
  },
  "keywords": [
    "canvas",
    "react",
    "ui",
    "components",
    "graph",
    "editor",
    "design-kit"
  ],
  "license": "Apache-2.0",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    // `@invana/styling` exposes `./themes.config` as raw, un-compiled `.ts` (no
    // shipped `.d.ts`), and `@invana/themes`' published types import it. tsc then
    // type-checks that source and trips on the dependency's own latent errors —
    // and `skipLibCheck` can't suppress a `.ts`. Redirect the specifier to a local
    // declaration stub (tsc-only; bundlers resolve the real module at runtime).
    // Same fix as `apps/storybook/tsconfig.json`. Remove once the dependency ships
    // compiled types.
    "paths": {
      "@invana/styling/themes.config": ["./types/styling-themes-config.d.ts"]
    }
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["node_modules", "dist"]
}

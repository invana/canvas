{
  "name": "@invana/canvas",
  "version": "0.0.8",
  "description": "WebGPU-first canvas rendering engine — Layer / Behaviour / Layout architecture (see architecture-proposal.md).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "default": "./dist/primitives/index.js"
    }
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ tests/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@invana/canvas-store": "workspace:*",
    "immer": "^11.1.4",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.18.1",
    "rbush": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/rbush": "^4.0.0",
    "happy-dom": "^20.9.0",
    "tsup": "^8.3.5",
    "typescript": "5.9.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "keywords": [
    "canvas",
    "webgpu",
    "webgl",
    "visualization",
    "graph",
    "rendering"
  ],
  "license": "Apache-2.0",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

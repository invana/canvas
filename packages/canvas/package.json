{
  "name": "@invana/canvas",
  "version": "0.0.1",
  "description": "WebGPU-first canvas rendering engine — Layer / Behaviour / Layout architecture (see architecture-proposal.md).",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.ts",
  "typedocOptions": {
    "entryPoints": ["src/index.ts"]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.18.1",
    "rbush": "^4.0.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/rbush": "^4.0.0",
    "tsup": "^8.3.5",
    "typescript": "5.9.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "keywords": ["canvas", "webgpu", "webgl", "visualization", "graph", "rendering"],
  "license": "Apache-2.0"
}

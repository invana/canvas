{
  "name": "@invana/canvas-react",
  "version": "0.0.11",
  "description": "React bindings for @invana/canvas — declarative <Canvas> with JSX children mapped to layers, behaviours, and layouts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@invana/canvas-store": "workspace:*",
    "@invana/themes": "^0.0.19",
    "lucide-react": "^0.562.0"
  },
  "peerDependencies": {
    "@invana/canvas": "workspace:*",
    "@invana/ui": "*",
    "@invana/graph": "workspace:*",
    "@invana/graph-layout-d3-force": "workspace:*",
    "pixi.js": "^8.18.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@invana/canvas": "workspace:*",
    "@invana/graph": "workspace:*",
    "@invana/graph-layout-d3-force": "workspace:*",
    "@invana/themes": "^0.0.19",
    "@invana/ui": "^0.0.19",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "lucide-react": "^0.562.0",
    "pixi.js": "^8.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "5.9.2"
  },
  "keywords": [
    "canvas",
    "react",
    "graph",
    "visualization",
    "pixi"
  ],
  "license": "Apache-2.0",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

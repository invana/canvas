{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    // `@invana/styling@0.0.6` exposes `./themes.config` as raw, un-compiled
    // `.ts` (no shipped `.d.ts`), which `@invana/themes`' types import. tsc then
    // type-checks that source and trips on the package's own latent errors —
    // and `skipLibCheck` can't suppress a `.ts`. Redirect the specifier to a
    // local declaration stub (tsc-only; the bundler resolves the real module at
    // runtime). Remove once the dependency ships compiled types.
    "paths": {
      "@invana/styling/themes.config": ["./types/styling-themes-config.d.ts"]
    }
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["node_modules", "dist"]
}

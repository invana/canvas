{
  "name": "@invana/graph-layer-d3-contour",
  "version": "0.0.1",
  "description": "Density-contour overlay Layer for @invana/graph, backed by d3-contour.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.ts",
  "typedocOptions": {
    "entryPoints": ["src/index.ts"]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "d3-contour": "^4.0.2"
  },
  "peerDependencies": {
    "@invana/canvas": "workspace:*",
    "@invana/graph": "workspace:*",
    "pixi.js": "^8.18.1"
  },
  "devDependencies": {
    "@invana/canvas": "workspace:*",
    "@invana/graph": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/d3-contour": "^3.0.6",
    "pixi.js": "^8.18.1",
    "tsup": "^8.3.5",
    "typescript": "5.9.2"
  },
  "keywords": ["canvas", "graph", "layer", "d3", "d3-contour", "density", "contour"],
  "license": "Apache-2.0"
}

{
  "name": "@invana/graph",
  "version": "0.0.5",
  "description": "Graph layer + behaviours for @invana/canvas — GraphLayer, MiniMapLayer, hover/select/lasso/brush/pan/drag behaviours.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "peerDependencies": {
    "@invana/canvas": "workspace:*",
    "pixi.js": "^8.18.1"
  },
  "devDependencies": {
    "@invana/canvas": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "pixi.js": "^8.18.1",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "canvas",
    "graph",
    "nodes",
    "edges",
    "visualization"
  ],
  "license": "Apache-2.0",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

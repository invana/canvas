{
  "name": "@canvas/ts-doc",
  "version": "0.0.1",
  "private": true,
  "description": "TypeDoc API documentation for all @invana/canvas packages",
  "type": "module",
  "scripts": {
    "build": "typedoc",
    "dev": "concurrently \"chokidar '../../packages/*/src/**/*.ts' -c 'typedoc' --initial\" \"live-server dist --port=7000 --no-browser\"",
    "serve": "live-server dist --port=7000",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "concurrently": "^9.1.2",
    "chokidar-cli": "^3.0.0",
    "live-server": "^1.2.2",
    "typedoc": "^0.27.9",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "@invana/canvas": "workspace:*",
    "@invana/layouts-d3-force": "workspace:*"
  }
}

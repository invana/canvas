{
  "name": "@invana/canvas-react",
  "version": "0.0.15",
  "description": "React bindings for @invana/canvas — declarative <Canvas> with JSX children mapped to layers, behaviours, and layouts.",
  "homepage": "https://github.com/invana/canvas#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@invana/canvas-store": "^0.0.15",
    "@invana/themes": ">=0.0.32 <0.1.0",
    "lucide-react": "^0.562.0"
  },
  "peerDependencies": {
    "@invana/canvas": "^0.0.15",
    "@invana/graph": "^0.0.15",
    "@invana/graph-layer-d3-contour": "^0.0.15",
    "@invana/graph-layer-maplibre": "^0.0.15",
    "@invana/graph-layout-d3-force": "^0.0.15",
    "@invana/graph-layout-d3-sankey": "^0.0.15",
    "@invana/graph-layout-elkjs": "^0.0.15",
    "pixi.js": "^8.21.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@invana/renderer-pixijs": "^0.0.15"
  },
  "peerDependenciesMeta": {
    "@invana/graph-layer-d3-contour": {
      "optional": true
    },
    "@invana/graph-layer-maplibre": {
      "optional": true
    },
    "@invana/graph-layout-d3-sankey": {
      "optional": true
    },
    "@invana/graph-layout-elkjs": {
      "optional": true
    }
  },
  "keywords": [
    "canvas",
    "react",
    "graph",
    "visualization",
    "pixi"
  ],
  "bugs": {
    "url": "https://github.com/invana/canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invana/canvas.git",
    "directory": "packages/canvas-react"
  },
  "license": "Apache-2.0",
  "author": "Ravi Raja Merugu",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

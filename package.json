{
  "name": "@invana/graph-layout-geometric",
  "version": "0.0.15",
  "description": "Dependency-free geometric layouts (grid / snake / circular) for @invana/graph.",
  "homepage": "https://github.com/invana/canvas#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@invana/canvas-core": "^0.0.15",
    "@invana/graph": "^0.0.15"
  },
  "keywords": [
    "canvas",
    "graph",
    "layout",
    "grid",
    "snake",
    "circular"
  ],
  "bugs": {
    "url": "https://github.com/invana/canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invana/canvas.git",
    "directory": "packages/graph-layout-geometric"
  },
  "license": "Apache-2.0",
  "author": "Ravi Raja Merugu",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

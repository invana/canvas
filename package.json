{
  "name": "@invana/canvas-designer",
  "version": "0.0.15",
  "description": "Node/Edge template designer for @invana/canvas — WYSIWYG authoring of composite node templates (drag canvas, layers, undo/redo, save/load); ships default starter templates. Optional: rendering templates needs only @invana/graph.",
  "homepage": "https://github.com/invana/canvas#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@invana/canvas-ui": "^0.0.15",
    "@invana/graph": "^0.0.15",
    "@invana/ui": ">=0.0.32 <0.1.0",
    "@invana/forms": ">=0.0.32 <0.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7"
  },
  "keywords": [
    "canvas",
    "graph",
    "designer",
    "node-template",
    "card",
    "react"
  ],
  "bugs": {
    "url": "https://github.com/invana/canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invana/canvas.git",
    "directory": "packages/canvas-designer"
  },
  "license": "Apache-2.0",
  "author": "Ravi Raja Merugu",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

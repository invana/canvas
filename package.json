{
  "name": "@invana/canvas",
  "private": true,
  "description": "High-performance WebGPU-first canvas rendering engine and visualization toolkit",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && node scripts/check-renderer-boundary.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "changelog": "git-cliff -o CHANGELOG.md",
    "storybook": "pnpm --filter @canvas/storybook dev",
    "docs": "pnpm --filter @canvas/docs build",
    "docs:dev": "pnpm --filter @canvas/docs dev",
    "docs:preview": "pnpm --filter @canvas/docs preview",
    "check-boundaries": "node scripts/check-renderer-boundary.mjs"
  },
  "devDependencies": {
    "git-cliff": "^2.13.1",
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=18"
  }
}
